NODE_ENV=production
DATABASE_URL=
JWT_SECRET=
RESET_TOKEN_SECRET=
FRONTEND_URL=
TRUST_PROXY=1
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
ORGANIZATION_EMAIL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
# Web Push (browser notifications). Generate once with: npx web-push generate-vapid-keys
# Without these, push is switched off and only in-app notifications work.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=

# Optional (defaults shown)
# PORT=5000
# DOCUMENTS_MAX_FILE_SIZE_MB=25
# CERTIFICATE_MAX_FILE_SIZE_MB=20
# CERTIFICATE_MAX_FILES=30
# Only for prisma/seed.permissions.js: "true" lets it overwrite existing levels in production
# SEED_RESET_PERMISSIONS=false
